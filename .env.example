# Copy this file to .env.local and fill in real values. All NEXT_PUBLIC_* vars are
# inlined into the browser bundle at BUILD time — changing them requires a rebuild/redeploy.

# Supabase (public config — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Google Maps JavaScript SDK key (used by lib/maps.ts for Places + Directions).
# Restrict this key by HTTP referrer in Google Cloud. Enable: Maps JavaScript API,
# Places API, Directions API. Full setup instructions: see MAPS-SETUP.md at the repo root.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza-your-maps-key-here
